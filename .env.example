# Environment Variables
# Copy this file to .env.local and fill in values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=QRForge

# Supabase (required for auth, dashboard, dynamic QR, analytics)
# Get these from your Supabase project: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rate Limiting
RATE_LIMIT_ANONYMOUS_QR_PER_HOUR=20
RATE_LIMIT_AUTH_QR_PER_HOUR=100
